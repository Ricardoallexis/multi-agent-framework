# Private/local workspace: secrets, databases, runs, assets, test data, backups
.local/

# Environment / secrets
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Python environments and generated files
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Runtime artifacts outside .local (defense in depth)
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
