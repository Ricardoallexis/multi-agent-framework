{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(python -m pytest:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(irm *)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git * push*)",
      "Bash(git -C * push*)",
      "Bash(* -c *git push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -r*)",
      "Bash(rm *-r*)",
      "Bash(rm *-R*)",
      "Bash(rm *--recursive*)",
      "Bash(rmdir /s*)",
      "Bash(git clean *)",
      "PowerShell(git push *)",
      "PowerShell(git * push *)",
      "PowerShell(git -C * push*)",
      "PowerShell(* -c *git push*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Invoke-Expression *)",
      "Bash(* --dangerously-skip-permissions*)",
      "PowerShell(* --dangerously-skip-permissions*)",
      "Bash(* --dangerously-bypass-approvals-and-sandbox*)",
      "PowerShell(* --dangerously-bypass-approvals-and-sandbox*)",
      "Bash(* --allow-all*)",
      "PowerShell(* --allow-all*)",
      "Bash(* --yolo*)",
      "PowerShell(* --yolo*)",
      "Bash(* --approve-for-me*)",
      "PowerShell(* --approve-for-me*)",
      "Bash(* --assisted-approval*)",
      "PowerShell(* --assisted-approval*)",
      "Bash(*danger-full-access*)",
      "PowerShell(*danger-full-access*)",
      "Bash(*bypassPermissions*)",
      "PowerShell(*bypassPermissions*)",
      "Bash(* --dangerously-bypass-hook-trust*)",
      "PowerShell(* --dangerously-bypass-hook-trust*)",
      "Bash(python -m pytest*--basetemp*)",
      "PowerShell(python -m pytest*--basetemp*)",
      "Read(.env*)",
      "Read(.local/**)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.git-credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.copilot/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Bash(claude --dangerously-skip-permissions*)",
      "Bash(claude --permission-mode bypassPermissions*)",
      "Bash(codex --dangerously-bypass-approvals-and-sandbox*)",
      "Bash(copilot --allow-all*)",
      "Bash(copilot --allow-all-urls*)",
      "PowerShell(copilot --allow-all-urls*)"
    ],
    "defaultMode": "default",
    "blockReadsOutsideWorkingDirectories": true
  }
}
