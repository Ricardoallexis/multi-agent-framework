# Copy this file to .local/.env. Never commit the real .local/.env.
APP_HOST=127.0.0.1
APP_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# Exact host names the API accepts (JSON list, no ports or wildcards). Protects the local
# API from DNS rebinding; do not expose the server to a network without authentication.
API_ALLOWED_HOSTS=["127.0.0.1", "localhost"]

# Optional: move all private runtime data outside the repository.
# LOCAL_DIR=C:\\Users\\you\\multi-agent-framework-local

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONTEXT_SOFT_LIMIT=0.75

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_GROUNDED_MODEL=gemini-3.5-flash
GEMINI_ADVANCED_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=configure-me
OPENAI_ENABLED=false

# Which certificates the provider clients (Gemini, OpenAI, Ollama) trust: certifi (the bundle of the clients, the default),
# system (the certificate store of the operating system, for an antivirus or proxy that inspects TLS) or file:<path> to a
# PEM file of your own. The «Usar los certificados de Windows» button of «Apps y agentes» writes `system` in
# gui-settings.json, and that file wins over this line (docs/BACKENDS.md, «Provider certificates»).
PROVIDER_TLS_TRUST=certifi

# OpenTelemetry traces and metrics of the native engine (needs `pip install '.[otel]'`). Off by default. The exporter is
# OTLP, configured by the standard variables (OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_EXPORTER_OTLP_HEADERS, OTEL_SERVICE_NAME).
# Prompts and responses are not attached to spans unless the second setting is on.
TELEMETRY_OTEL_ENABLED=false
TELEMETRY_OTEL_CAPTURE_CONTENT=false

MAX_LLM_CALLS=4
MAX_RUN_SECONDS=300
# Select the execution backend for queued runs (native by default).
EXECUTION_BACKEND=native
WORKER_POLL_SECONDS=0.75
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
# Uncomment to set cross-process limits (omitted means unlimited).
# WORKER_MAX_ACTIVE_TOTAL=4
# WORKER_MAX_ACTIVE_PER_PROJECT=2
WORKER_LEASE_SECONDS=30
WORKER_SHUTDOWN_WAIT_SECONDS=30
# Longest a live evaluation case waits for its run (multiagent eval run --live).
EVAL_LIVE_TIMEOUT_SECONDS=900
EVAL_REGRESSION_THRESHOLD=0.0

# Built-in file tools (file.list, file.read, file.write, file.move). Unset or empty registers none;
# when set, all file tool paths are confined inside this resolved folder (docs/LOCAL_WORKSPACE.md).
# FILE_TOOLS_ROOT=

# Executor applications (ORQ-T51). Work folders the framework creates for tasks (default <local_dir>/executor_runs),
# the longest an attempt may run, and how long an executor is paused after a quota or limit error.
# EXECUTOR_WORKDIR_ROOT=
EXECUTOR_TIMEOUT_SECONDS=1800
EXECUTOR_QUOTA_PAUSE_MINUTES=300

# Antigravity (agy) executor, supervised and off by default (docs/EXECUTORS.md).
# Third-party notice: Antigravity (agy) runs with the subscription of the person who enables it, through its official
# CLI. Review your plan's terms before you enable it. The framework spends no AI credits, but only if you keep them
# turned off in your account. Respect the quota limits that `agy /usage` shows. Do not use it with shared or third-party
# accounts.
# Besides `enabled: true` in the catalog, enabling it requires accepting the notice above by setting
# ANTIGRAVITY_NOTICE_ACCEPTED=agy-third-party-notice/1. While the kill-switch file exists (default
# <data_dir>/antigravity-off) nothing is launched; the lock file keeps one agy run at a time. The add dirs are absolute
# folders a write run may also see (a JSON list or items separated by ';').
# ANTIGRAVITY_NOTICE_ACCEPTED=
# ANTIGRAVITY_KILL_SWITCH=
# ANTIGRAVITY_LOCK_FILE=
# ANTIGRAVITY_ADD_DIRS=

# Antigravity (agy) sessions: where its conversation summaries live (default ~/.gemini/antigravity-cli). The session
# viewer and `multiagent sessions` list them when "antigravity" is in GUI_SESSION_SOURCES (it is by default).
# GUI_ANTIGRAVITY_HOME=
EXTERNAL_PREVIEW_TTL_SECONDS=900
EXTERNAL_EVIDENCE_MAX_FILE_BYTES=10000000
EXTERNAL_EVIDENCE_MAX_TOTAL_BYTES=25000000
