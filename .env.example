# Copy this file to .local/.env. Never commit the real .local/.env.
APP_HOST=127.0.0.1
APP_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Optional: move all private runtime data outside the repository.
# LOCAL_DIR=C:\\Users\\you\\multi-agent-framework-local

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONTEXT_SOFT_LIMIT=0.75

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_GROUNDED_MODEL=gemini-3.5-flash
GEMINI_ADVANCED_MODEL=gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=configure-me
OPENAI_ENABLED=false

MAX_LLM_CALLS=4
MAX_RUN_SECONDS=300
WORKER_POLL_SECONDS=0.75
WORKER_ENABLED=true
