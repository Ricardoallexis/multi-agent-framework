@echo off
rem Copyright 2026 Ricardoallexis and contributors
rem SPDX-License-Identifier: Apache-2.0
rem
rem Double-click: sets things up the first time and opens the interface.
rem Always uses "python -m ...": never an executable generated by pip. It only touches this folder and the local folder.
setlocal EnableExtensions DisableDelayedExpansion
chcp 65001 >nul
cd /d "%~dp0"

set "DOWNLOAD_URL=https://www.python.org/downloads/"
set "VENV_PY=.venv\Scripts\python"
set "MARK=.venv\.maf-ready"
set "LOCAL_DIR_USED=.local"
if defined LOCAL_DIR set "LOCAL_DIR_USED=%LOCAL_DIR%"
set "START_FILE=%LOCAL_DIR_USED%\primer-recorrido-inicio.txt"
set "PIP_DISABLE_PIP_VERSION_CHECK=1"
set "PY_CMD="

echo Multi-Agent Framework: start

if exist "%VENV_PY%.exe" goto have_python
if exist "%VENV_PY%.cmd" goto have_python

where py >nul 2>nul
if errorlevel 1 goto no_python
for %%V in (3.14 3.13 3.12) do (
  if not defined PY_CMD (
    call py -%%V -c "import sys" >nul 2>nul
    if not errorlevel 1 set "PY_CMD=py -%%V"
  )
)
if not defined PY_CMD goto no_python

:have_python
rem 1. The start time, written once (never overwritten).
if not exist "%START_FILE%" (
  if not exist "%LOCAL_DIR_USED%" mkdir "%LOCAL_DIR_USED%"
  "%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -Command "Get-Date -Format o" > "%START_FILE%"
  if errorlevel 1 (
    set "FAIL=could not write down the start time."
    goto fail
  )
)

rem 3. The environment.
if exist "%VENV_PY%.exe" goto have_venv
if exist "%VENV_PY%.cmd" goto have_venv
echo [1/4] Creating the environment (first time only)...
call %PY_CMD% -m venv .venv
if errorlevel 1 (
  set "FAIL=step 1 of 4, creating the environment (.venv)."
  goto fail
)
:have_venv

rem 4 to 6. Dependencies, database and marker.
set "WANTED="
for /f "skip=1 delims=" %%H in ('certutil -hashfile requirements.txt SHA256 2^>nul') do if not defined WANTED set "WANTED=%%H"
if not defined WANTED (
  set "FAIL=could not compute the fingerprint of requirements.txt."
  goto fail
)
set "WANTED=%WANTED: =%"
set "CURRENT="
if exist "%MARK%" set /p CURRENT=<"%MARK%"
if "%CURRENT%"=="%WANTED%" goto start_gui

echo [2/4] Installing the dependencies (this can take a few minutes)...
call "%VENV_PY%" -m pip install -r requirements.txt
if errorlevel 1 (
  set "FAIL=step 2 of 4, installing the dependencies."
  goto fail
)
echo [3/4] Preparing the database...
call "%VENV_PY%" -m multiagent init
if errorlevel 1 (
  set "FAIL=step 3 of 4, preparing the database."
  goto fail
)
>"%MARK%" echo %WANTED%
if errorlevel 1 (
  set "FAIL=could not save the installation marker."
  goto fail
)

:start_gui
rem 7. The interface.
echo [4/4] Opening the interface. To close it, close this window or press Ctrl+C.
call "%VENV_PY%" -m multiagent gui --launcher
if errorlevel 1 (
  set "FAIL=step 4 of 4, opening the interface."
  goto fail
)
exit /b 0

:no_python
echo I could not find Python on this computer.
echo I will open the download page: %DOWNLOAD_URL%
echo Download "Python 3.13" (the 64-bit installer) and, when installing, tick "py launcher".
echo Install it and open this file again. Nothing was created or changed.
call explorer %DOWNLOAD_URL%
echo.
echo Press any key to close this window.
pause >nul
exit /b 1

:fail
echo Could not finish: %FAIL%
echo.
echo Press any key to close this window.
pause >nul
exit /b 1
